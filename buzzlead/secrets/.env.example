# ============================================
# BUZZLEAD GTM AUTOMATION - API KEYS TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual API keys
# SECURITY: DO NOT commit .env to version control
# ============================================

# -----------------------------
# LIST BUILDING
# -----------------------------
AI_ARC_API_KEY=your_ai_arc_api_key_here
AI_ARC_BASE_URL=https://api.ai-ark.com/v1

# -----------------------------
# RESEARCH & SCRAPING
# -----------------------------
SERPER_DEV_API_KEY=your_serper_api_key_here
SERPER_DEV_BASE_URL=https://google.serper.dev

JINA_API_KEY=your_jina_api_key_here
JINA_BASE_URL=https://r.jina.ai

SPIDER_API_KEY=your_spider_api_key_here
SPIDER_BASE_URL=https://api.spider.cloud

# -----------------------------
# LLM PROCESSING (via OpenRouter)
# -----------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model IDs
RESEARCH_MODEL=openai/gpt-4.5-preview
SCRIPTING_MODEL=anthropic/claude-3-haiku

# -----------------------------
# CLAY INTEGRATION
# -----------------------------
CLAY_API_KEY=your_clay_api_key_here
CLAY_BASE_URL=https://api.clay.com/v1

# -----------------------------
# EMAIL VERIFICATION
# -----------------------------
MILLIONVERIFIER_API_KEY=your_millionverifier_api_key_here
BOUNCEBAN_API_KEY=your_bounceban_api_key_here

# -----------------------------
# ADDITIONAL DATA SOURCES
# -----------------------------
LEAD_MAGIC_API_KEY=your_lead_magic_api_key_here
FINDYMAIL_API_KEY=your_findymail_api_key_here

# ============================================
# COST REFERENCE (per 1,000 contacts)
# ============================================
# AI Arc: ~$5-10 (0.5-1 credit per contact)
# SerperDev: ~$1-2 (1000 searches = $1)
# Jina: ~$1 (~$0.001 per call)
# Spider: ~$10 (~$0.01 per page)
# OpenRouter GPT-4.5: ~$15-20 (varies by tokens)
# OpenRouter Haiku: ~$5-10 (varies by tokens)
# ============================================
